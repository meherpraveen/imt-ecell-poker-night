{
  "name": "imt-ecell-poker-night",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test tests/event.test.cjs tests/gate-race.test.cjs tests/payments.test.mjs tests/receipt-amounts.test.mjs tests/student-sign-in.test.mjs tests/owner-password.test.mjs tests/capacity.test.mjs",
    "test:e2e": "node tools/build.mjs && playwright test --grep-invert @deployed",
    "test:deploy": "playwright test deployed.spec.mjs",
    "test:perf": "node tools/measure-pages.mjs",
    "test:capacity:live": "node tests/live-capacity.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "feather-icons": "4.29.2",
    "terser": "5.51.4"
  }
}
